# ============================================================
# CELLULOGRAM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# Use EAS Secrets for CI/CD: https://docs.expo.dev/build-reference/variables/

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Google OAuth ---
# Web Client ID: Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web Application)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Android Client ID: Created for SHA-1 fingerprint of your Android keystore
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
# iOS Client ID: Created for bundle ID com.cellulogram.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# --- Development Flags ----
# Set to 'true' to show the Rapid Evaluation Panel on the login screen.
# MUST be 'false' or removed for production builds.
EXPO_PUBLIC_ENABLE_MOCK_LOGIN=false
